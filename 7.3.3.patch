+import threading
+import time
+from cachetools import TTLCache
+
+def test_ttl_concurrency_bug():
+    cache = TTLCache(maxsize=100, ttl=0.1)
+    
+    # Simulate a bug where __getitem__ returns an item that is already expired
+    cache['key'] = 'value'
+    
+    exceptions = []
+    def reader():
+        for _ in range(10000):
+            try:
+                # Sleep a tiny bit to increase chance of race condition
+                val = cache['key']
+                # If we get here, and it's been > 0.1s, it's a bug!
+            except KeyError:
+                pass
+            except Exception as e:
+                exceptions.append(e)
+            time.sleep(0.00001)
+
+    def writer():
+        for i in range(100):
+            cache[f'key{i}'] = 'value'
+            time.sleep(0.001)
+
+    t1 = threading.Thread(target=reader)
+    t2 = threading.Thread(target=writer)
+    
+    start = time.time()
+    t1.start()
+    t2.start()
+    
+    # We wait until at least 0.2s has passed
+    time.sleep(0.2)
+    # Now 'key' should definitely be expired
+    try:
+        val = cache['key']
+        print("BUG: returned expired key!")
+    except KeyError:
+        print("OK: KeyError raised")
+    
+    t1.join()
+    t2.join()
+    
+    if exceptions:
+        print("Exceptions:", exceptions)
+
+if __name__ == '__main__':
+    test_ttl_concurrency_bug()
