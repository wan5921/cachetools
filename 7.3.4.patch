index e023173..eeec04f 100644
--- a/tests/test_ttl.py
+++ b/tests/test_ttl.py
@@ -1,4 +1,6 @@
 import math
+import threading
+import time
 import unittest
 
 from cachetools import TTLCache
@@ -245,3 +247,123 @@ class TTLCacheTest(unittest.TestCase, CacheTestMixin):
         cache.timer.tick()
         cache.timer.tick()  # past TTL
         self.assertNotIn(42, cache)
+
+    def test_ttl_concurrent(self):
+        cache = TTLCache(maxsize=100, ttl=0.05, timer=time.monotonic)
+
+        errors = []
+        stop = threading.Event()
+
+        def reader():
+            try:
+                while not stop.is_set():
+                    try:
+                        cache["key"]
+                    except KeyError:
+                        pass
+                    except Exception as e:
+                        errors.append(e)
+            except Exception as e:
+                errors.append(e)
+
+        def writer():
+            try:
+                for i in range(50):
+                    try:
+                        cache[i] = i
+                    except Exception as e:
+                        errors.append(e)
+                    time.sleep(0.001)
+            except Exception as e:
+                errors.append(e)
+
+        cache["key"] = "value"
+
+        threads = []
+        for _ in range(10):
+            t = threading.Thread(target=writer)
+            threads.append(t)
+        for _ in range(10):
+            t = threading.Thread(target=reader)
+            threads.append(t)
+
+        for t in threads:
+            t.start()
+
+        for t in threads:
+            t.join(timeout=10)
+
+        stop.set()
+
+        time.sleep(0.1)
+
+        self.assertEqual(0, len(errors))
+
+        with self.assertRaises(KeyError):
+            cache["key"]
+
+    def test_ttl_concurrent_expiry(self):
+        cache = TTLCache(maxsize=10, ttl=0.1)
+        cache["test_key"] = "test_value"
+
+        self.assertEqual("test_value", cache["test_key"])
+
+        errors = []
+        lock = threading.Lock()
+        seen_valid = []
+        seen_keyerror = []
+        NITER = 200
+        NTHREADS = 20
+
+        def worker():
+            try:
+                for _ in range(NITER):
+                    try:
+                        val = cache["test_key"]
+                        if val == "test_value":
+                            with lock:
+                                seen_valid.append(1)
+                        else:
+                            with lock:
+                                errors.append(
+                                    Exception(f"Unexpected value: {val}")
+                                )
+                    except KeyError:
+                        with lock:
+                            seen_keyerror.append(1)
+            except Exception as e:
+                with lock:
+                    errors.append(e)
+
+        def writer():
+            for i in range(100):
+                try:
+                    cache[i] = i
+                except Exception as e:
+                    with lock:
+                        errors.append(e)
+
+        threads = [threading.Thread(target=worker) for _ in range(NTHREADS)]
+        threads.append(threading.Thread(target=writer))
+
+        for t in threads:
+            t.start()
+
+        for t in threads:
+            t.join(timeout=10)
+
+        time.sleep(0.2)
+
+        with self.assertRaises(KeyError):
+            cache["test_key"]
+
+        self.assertEqual(
+            0, len(errors),
+            f"Got {len(errors)} error(s): {errors}"
+        )
+
+        self.assertGreater(
+            len(seen_keyerror), 0,
+            "Expected at least one KeyError from expired reads"
+        )
+
