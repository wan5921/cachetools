+    @unittest.skipIf(time_machine is None, "time-machine not installed")
+    def test_ttl_time_machine_lazy_expire_until_write(self):
+        from datetime import datetime, timedelta
+
+        with time_machine.travel(datetime(2024, 1, 1, 0, 0, 0), tick=False) as traveller:
+            cache = TTLCache[str, int, datetime](
+                maxsize=2, ttl=timedelta(seconds=5), timer=datetime.now
+            )
+
+            cache["a"] = 1
+            self.assertEqual(1, Cache.__len__(cache))
+
+            traveller.shift(timedelta(seconds=6))
+
+            self.assertEqual(1, Cache.__len__(cache))
+            cache["b"] = 2
+            self.assertEqual(1, Cache.__len__(cache))
+            self.assertNotIn("a", cache)
+            self.assertEqual(2, cache["b"])
